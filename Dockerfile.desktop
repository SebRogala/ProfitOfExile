FROM rust:1.94-bookworm

RUN apt-get update && apt-get install -y \
    nodejs npm \
    libwebkit2gtk-4.1-dev \
    libappindicator3-dev \
    librsvg2-dev \
    patchelf \
    libssl-dev \
    pkg-config \
    binutils-mingw-w64-x86-64 gcc-mingw-w64-x86-64 \
    && rm -rf /var/lib/apt/lists/*

# Windows std so `make desktop-check-windows` can type-check the cfg(windows)
# half of the crate (overlay hook, click-through, capture) without a Windows
# machine; mingw above supplies the windres/gcc tauri-build's resource step
# needs. This is a type-check target only, never a build target.
RUN rustup target add x86_64-pc-windows-gnu

# Install newer Node via n
RUN npm install -g n && n lts && hash -r

WORKDIR /app/desktop/src-tauri

CMD ["cargo", "check"]
