              "filters": {
                "category": {
                  "option": "gem"
                }
              }
            },
            "misc_filters": {
              "filters": {
                "corrupted": {
                  "option": "false"
                }
              }
            },
            "trade_filters": {
              "filters": {
                "sale_type": {
                  "option": "priced"
                },
                "collapse": {
                  "option": "true"
                }
              }
            }
          },
          "status": {
            "option": "securable"
          }
        },
        "sort": {
          "price": "asc"
        }
