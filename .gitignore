.idea/
.mcp.json
.env
bin/
/server
/collector
/.codex
/optimize
/promote
/recalculate
tmp/
frontend/node_modules/
frontend/.svelte-kit/
frontend/build/
cmd/server/frontend_build/*
!cmd/server/frontend_build/.gitkeep
data/
# Fetched gem icon bytes (copyright + weight) — never commit; the embedded
# URL map in internal/gemicon/ is the only committed part. Covered by data/
# above for the default path, but kept explicit in case the dir is relocated.
data/gem-icons-cache/
# Pre-seed dumps the documented puller writes at the repository root before they
# are copied into the production volumes. Same copyrighted bytes, outside data/.
gem-icons-cache/
currency-exchange-icons-cache/
# The merc seed-art test fixture (POE-208): the SAME copyrighted bytes as
# above, reached through the same route, so the same rule applies. Unlike the
# 39x39 crops in ../merc-icon-crops (screenshots of a running game), these are
# complete, reusable CC-BY-NC-SA inventory icons, and this repository is
# GPL-3.0 — vendoring them would relicense what cannot be relicensed. Fetch
# them with `make merc-seed-art`; the README stays committed and says so.
desktop/src-tauri/tests/fixtures/merc-seed-art/*
!desktop/src-tauri/tests/fixtures/merc-seed-art/README.md
desktop/src-tauri/target/
desktop/node_modules/
desktop/.svelte-kit/
desktop/build/
.superpowers/
.claude/worktrees/
# Pipeforge writes per-run triage state here. Untracked and unignored, it made
# the pipeline's own `git status --porcelain` precheck report a dirty tree and
# stop before doing any work.
.claude/pipeforge/

# Tauri signing keys (private key MUST NOT be committed)
desktop/.tauri/
.env.local
