 "_owners": {
  "profiles": "desktop built-in boss-profile table (Rust, beside loot_capture.rs) — config, shipped with the app",
  "testProfiles": "test-only data, same shape as profiles",
  "capture": "desktop session: OCR of the capture (loot_capture.rs) + Client.txt zone/level/seed (lab_state.rs parser)",
  "capture.attribution": "derived (client, this task): latest non-town/hideout 'Generating level NN area \"<id>\" with seed N' matched against profiles[].area + level",
  "stats": "server: boss-loot run aggregates per boss and scope (endpoint not designed; stub)",
  "stats.*.items[].rate": "derived (client, this task): round(drops / runs × 100) + '%'; '—' when runs = 0 or the item is not counted",
  "runs": "server: boss-loot runs for this device (endpoint not designed; stub)",
  "submit": "server: submit-run endpoint (not designed; stub the outcomes listed)",
  "moduleSettings": "desktop settings (persisted; ui_prefs vs Settings struct is the implementer's call per ADR-013)",
  "overlaySettings": "desktop settings: Settings.widgets placement map + a ui_prefs key for the layout",
  "device": "desktop: the existing device identity"
 },
 "_formats": {
  "rate": "whole percent, Math.round(drops/runs*100), e.g. 31% for 24/78; provenance 'drops/runs' e.g. 24/78; never decimals",
  "wikiRate": "display text exactly as stored (~50%, <0.5%, 3–5%, —); never parsed",
  "counts": "plain integers, no grouping (values stay below 1,000 in this fixture; larger values go through groupNumber())",
  "runDate": "null for seed runs → render 'no date'",
  "countdown": "whole seconds"
 },
